# Copy this file to .env and put your real key in .env (never in this file).
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE
MODEL=gemini-3.8-flash
FALLBACK_MODEL=gemini-3.5-flash-lite
# low keeps replies fast, high thinks more, empty lets the model decide.
THINKING_LEVEL=low
# Live web search: off | auto (the model decides) | always (search on every message)
WEB_SEARCH=auto
MAX_TOKENS=2048
HISTORY_CHARS=8000
PORT=3000
# MOCK_LLM=true   # uncomment to test the interface without an API key
